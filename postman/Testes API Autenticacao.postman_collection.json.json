  "item": [
    {
      "name": "CT01 - Login Valido",
      "request": {
        "auth": {
          "type": "noauth"
        },
        "method": "POST",
        "header": [
          {
            "key": "apikey",
            "value": "{{api_key}}"
          },
          {
            "key": "Content-Type",
            "value": "\tapplication/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "\r\n{\r\n  \"email\": \"{{email}}\",\r\n  \"password\": \"{{password}}\"\r\n}\r\n",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        },
        "url": {
          "raw": "{{base_url}}/auth/v1/token?grant_type=password",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "auth",
            "v1",
            "token"
          ],
          "query": [
            {
              "key": "grant_type",
              "value": "password"
            }
          ]
        }
      },
      "response": []
    },
